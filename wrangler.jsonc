{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exploration-fonctionnelle",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "exploration-fonctionnelle", "database_id": "e57fb800-a78f-47ba-aa42-dd5cb2667f9f" }
  ],
  "observability": { "enabled": true }
}
